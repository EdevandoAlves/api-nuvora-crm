PORT=3000

# JWT
SECRET_KEY=replace_with_a_secure_secret

# PostgreSQL (matches docker-compose.yml)
TYPEORM_CONNECTION=postgres
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=
TYPEORM_DATABASE=nuvora_crm

# Password recovery link base
FRONTEND_URI=http://localhost:5173/

# SMTP (dummy local values let the module boot; replace for real email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev

NODE_ENV=development
